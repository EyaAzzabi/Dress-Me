SECRET_KEY=change-me
# Comma-separated browser origins allowed to call this API (CORS). Defaults cover
# local dev (Vite web, Expo web/Metro) — add your deployed web origin here too.
CORS_ORIGINS=http://localhost:5173,http://localhost:8081,http://localhost:8082,http://localhost:19006
DATABASE_URL=postgresql+psycopg://dressme:dressme@localhost:5432/dressme
# Team Supabase (project fpuudgbekppqbjtwmowm) — replace PASSWORD from
# Project Settings > Database > Database password. Keep this out of git.
# DATABASE_URL=postgresql+psycopg://postgres:PASSWORD@db.fpuudgbekppqbjtwmowm.supabase.co:5432/postgres?sslmode=require
PINECONE_API_KEY=
PINECONE_INDEX_NAME=dressme-clothing-embeddings
STORAGE_BUCKET=dressme-wardrobe
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only for S3-compatible non-AWS storage (MinIO, DigitalOcean Spaces, ...). Leave
# unset for real AWS S3.
STORAGE_ENDPOINT_URL=
# Dev/testing-only alternative to the AWS_* settings above — writes wardrobe photos
# to local disk instead of any cloud storage, served back via /media. Leave unset in
# any real deployment. PUBLIC_BASE_URL must match wherever this API is actually
# reachable (the mobile app and the backend's own Vision Agent both fetch image_url
# over HTTP, so "localhost" only works when both run on the same machine).
LOCAL_STORAGE_DIR=
PUBLIC_BASE_URL=http://localhost:8000
OPENWEATHER_API_KEY=
# LLM (optional): none (default) | groq | gemini | ollama | openai | mistral | llama
# Purchase uses the same provider for its tool-calling agent (app/ml/purchase_llm.py)
# when no LoRA adapter is on disk. LLM_PROVIDER=none -> template explanations.
LLM_PROVIDER=none
LLM_API_KEY=
PURCHASE_LLM_ENABLED=true
# Recommended hosted option: Groq free developer account.
# LLM_PROVIDER=groq
# LLM_API_KEY=<paste your own Groq key locally, never commit it>
# LLM_MODEL=openai/gpt-oss-20b
# "llama" requires both URL and model; all others have overridable defaults.
# Ollama: LLM_PROVIDER=ollama, LLM_MODEL=qwen2.5:1.5b, LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
# Optional conversation override; saved profile/outfit/purchase narratives keep LLM_MODEL.
LLM_CHAT_MODEL=
LLM_CHAT_FALLBACK_MODEL=
LLM_CHAT_TIMEOUT_SECONDS=20
LLM_TIMEOUT_SECONDS=8
LLM_MAX_RETRIES=1
LLM_BACKOFF_SECONDS=0.25
LLM_MAX_BACKOFF_SECONDS=2
LLM_CACHE_TTL_SECONDS=3600
LLM_FAILURE_TTL_SECONDS=15
LLM_CACHE_MAX_ENTRIES=512

# Kill-switches (default true): ranking model appris + RAG contextuel.
RANKING_ENABLED=true
CONTEXTUAL_RAG_ENABLED=true
# Virtual try-on (TryOnAgent), via a Replicate.com account — no local GPU needed.
REPLICATE_API_TOKEN=
REPLICATE_TRYON_MODEL_VERSION=
REPLICATE_TRYON_SEND_CATEGORY=false
TRYON_PROVIDER=auto
HF_TRYON_SPACE=levihsu/OOTDiffusion
HF_TOKEN=
