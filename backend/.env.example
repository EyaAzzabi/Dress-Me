SECRET_KEY=change-me
# Comma-separated browser origins allowed to call this API (CORS). Defaults cover
# local dev (Vite web, Expo web/Metro) — add your deployed web origin here too.
CORS_ORIGINS=http://localhost:5173,http://localhost:8081,http://localhost:8082,http://localhost:19006
DATABASE_URL=postgresql+psycopg://dressme:dressme@localhost:5432/dressme
PINECONE_API_KEY=
PINECONE_INDEX_NAME=dressme-clothing-embeddings
STORAGE_BUCKET=dressme-wardrobe
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only for S3-compatible non-AWS storage (MinIO, DigitalOcean Spaces, ...). Leave
# unset for real AWS S3.
STORAGE_ENDPOINT_URL=
# Dev/testing-only alternative to the AWS_* settings above — writes wardrobe photos
# to local disk instead of any cloud storage, served back via /media. Leave unset in
# any real deployment. PUBLIC_BASE_URL must match wherever this API is actually
# reachable (the mobile app and the backend's own Vision Agent both fetch image_url
# over HTTP, so "localhost" only works when both run on the same machine).
LOCAL_STORAGE_DIR=
PUBLIC_BASE_URL=http://192.168.1.27:8000
# Vision Agent: optional OpenAI vision second opinion on uncertain photos (sends the photo to OpenAI).
OPENAI_API_KEY=
VISION_LLM_ENABLED=false
VISION_LLM_MODEL=gpt-4o-mini
# Prompt version (v1 | v2 | v3 ...); see app/ml/vision_llm.py and ml/notebooks/15_vision_prompt_versions.py
VISION_LLM_PROMPT_VERSION=v1
OPENWEATHER_API_KEY=
# LLM (optional, free tier Mistral): set LLM_PROVIDER=mistral + LLM_API_KEY to enable
# free-text occasion parsing + natural-language outfit explanations in the
# RecommendationAgent; LLM_PROVIDER=none (default) -> deterministic rules + templates.
LLM_PROVIDER=none
LLM_API_KEY=
# Recommended hosted option: Groq free developer account.
# LLM_PROVIDER=groq
# LLM_API_KEY=<paste your own Groq key locally, never commit it>
# LLM_MODEL=openai/gpt-oss-20b
# Alternatives: gemini (Google key), ollama (local, no key), openai, mistral, llama.
# "llama" requires both URL and model; all others have overridable defaults.
# Ollama: LLM_PROVIDER=ollama, LLM_MODEL=qwen2.5:3b, LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
# Optional conversation override; saved profile/outfit/purchase narratives keep LLM_MODEL.
# For Groq, a stronger conversation model: openai/gpt-oss-120b.
LLM_CHAT_MODEL=
# Optional same-provider fallback when the conversation model is rate-limited.
# Groq: openai/gpt-oss-20b (generated advice too, never the old phrase planner).
LLM_CHAT_FALLBACK_MODEL=
LLM_CHAT_TIMEOUT_SECONDS=20
LLM_TIMEOUT_SECONDS=8
LLM_MAX_RETRIES=1
LLM_BACKOFF_SECONDS=0.25
LLM_MAX_BACKOFF_SECONDS=2
LLM_CACHE_TTL_SECONDS=3600
LLM_FAILURE_TTL_SECONDS=15
LLM_CACHE_MAX_ENTRIES=512

# Kill-switches (default true): ranking model appris + RAG contextuel ;
# false -> heuristique/règles existantes exactes. The learned ranker + contextual RAG
# are used when artifacts/data are present; flip to false to force the legacy heuristic
# / skip RAG retrieval without redeploying.
RANKING_ENABLED=true
CONTEXTUAL_RAG_ENABLED=true
# Virtual try-on (TryOnAgent), via a Replicate.com account — no local GPU needed.
# REPLICATE_TRYON_MODEL_VERSION has no safe default (version ids change over time);
# copy the current one from the model's Replicate page (search "idm-vton" or
# "ootdiffusion") after creating an account.
REPLICATE_API_TOKEN=
REPLICATE_TRYON_MODEL_VERSION=
# Set to true for models that take a garment `category` input (e.g. IDM-VTON) — needed for
# the calendar's full-outfit render to dress bottoms and dresses correctly.
REPLICATE_TRYON_SEND_CATEGORY=false
# FREE alternative to Replicate (no API key needed): a public Hugging Face Space.
# TRYON_PROVIDER=auto uses Replicate if its credentials above are set, else this.
# HF_TOKEN is optional — create a free account at huggingface.co > Settings > Access
# Tokens (read) to get a bigger daily GPU quota than anonymous use.
TRYON_PROVIDER=auto
HF_TRYON_SPACE=levihsu/OOTDiffusion
HF_TOKEN=
